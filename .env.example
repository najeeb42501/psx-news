# Copy this file to .env and fill in values. Never commit .env.
# Each variable is added in the phase noted beside it.

# Phase 1: Supabase Postgres connection string (Connect > Direct > Session pooler, port 5432).
# Put the password in WITHOUT the [ ] brackets. If it contains # / @ : ? + $ etc.,
# they must be percent-encoded (e.g. # -> %23, / -> %2F).
DATABASE_URL=

# Phase 1: Supabase project URL and API keys (Project Settings > API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: overrides the contact email in the scraper User-Agent (default in pipeline/config/settings.py)
CONTACT_EMAIL=

# Which adapters to use (change these to swap vendors)
REPO_ADAPTER=postgres
PUBLISHERS=whatsapp_queue

# Phase 3: AI models (both have free tiers; one OpenAI-compatible client for both)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the model order (provider:model, comma-separated). Defaults are in
# pipeline/config/settings.py. LLM_CHAIN = summaries (needs good Urdu); LLM_EXTRACT_CHAIN = fact extraction.
LLM_CHAIN=
LLM_EXTRACT_CHAIN=

# Optional: path to tesseract.exe if it is not in the default install folder or on PATH
TESSERACT_CMD=

# v1.1: encrypts the nightly database backup (.github/workflows/backup.yml). Generate a long random
# value, put the same value in the GitHub secret BACKUP_PASSPHRASE, and keep a copy somewhere safe.
BACKUP_PASSPHRASE=
