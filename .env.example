# Copy this file to .env and fill in values. Never commit .env.
# Each variable is added in the phase noted beside it.

# Phase 1: Supabase Postgres connection string
DATABASE_URL=

# Phase 2: contact email shown in the scraper's User-Agent and on the About page
CONTACT_EMAIL=

# Which adapters to use (change these to swap vendors)
REPO_ADAPTER=postgres
PUBLISHERS=whatsapp_queue
