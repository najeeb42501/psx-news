# Copy to web/.env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API Keys). The secret key is used on the server only (admin pages).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The site's own address: used in links, share cards and the admin sign-in email.
SITE_URL=http://localhost:3000

# Admin sign-in (v1.1): emailed magic link through Supabase Auth, for emails in the admin_users
# table (uv run python -m pipeline.jobs.admins add you@example.com).
# ADMIN_SESSION_SECRET signs the session cookie: at least 32 random characters.
ADMIN_SESSION_SECRET=
# Emergency password sign-in, off unless ADMIN_ALLOW_PASSWORD=1. Remove once email sign-in works.
ADMIN_TOKEN=
ADMIN_ALLOW_PASSWORD=

# "local" lets the admin Jobs page start pipeline runs on this computer.
JOB_RUNNER=local

# Optional: links shown on the site once the channels exist.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
NEXT_PUBLIC_FACEBOOK_PAGE_URL=
